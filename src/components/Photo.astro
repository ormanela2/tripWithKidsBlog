---
/**
 * The one way to show a photo. Built on astro:assets <Picture>:
 * AVIF + WebP in several widths, width/height always set (no layout jump), lazy by default.
 *
 * Alt text is required. Use alt="" only together with `decorative` (purely visual images).
 * Photos live in src/assets/photos and are imported, never referenced by URL.
 * Own photos need no credit; Wikimedia Commons and other licensed photos must pass `credit`.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

type Props = {
  src: ImageMetadata;
  /** Describes what the photo shows (Hebrew). Required unless `decorative`. */
  alt: string;
  decorative?: boolean;
  /** Widths to generate, in CSS px of the largest display. */
  widths?: number[];
  /** How wide the image is shown, e.g. "(max-width: 600px) 100vw, 400px". */
  sizes?: string;
  /** Above-the-fold images: load immediately with high priority. */
  priority?: boolean;
  /** "Photo: name / licence" for photos that are not our own. */
  credit?: string;
  /** Format for browsers without AVIF/WebP. "jpg" for photos; "png" only for logos that need transparency. */
  fallbackFormat?: "jpg" | "png";
  class?: string;
  /** Extra attributes for the <img> (e.g. ids used by scripts). */
  imgAttrs?: Record<string, string>;
};

const { src, alt, decorative = false, widths, sizes = "100vw", priority = false, credit, fallbackFormat = "jpg", class: cls, imgAttrs = {} } = Astro.props;

if (!decorative && !alt.trim()) {
  throw new Error(`Photo: alt text is required (${src.src}). Use decorative for purely visual images.`);
}

// Never upscale: keep only widths up to the original's own width.
const wanted = widths ?? [320, 480, 640, 960, 1280];
const usable = wanted.filter(w => w <= src.width);
const finalWidths = usable.length ? usable : [src.width];
---
{credit ? (
  <figure class:list={["photo", cls]}>
    <Picture src={src} alt={decorative ? "" : alt} formats={["avif", "webp"]} fallbackFormat={fallbackFormat} quality={72} width={Math.max(...finalWidths)} widths={finalWidths} sizes={sizes}
      loading={priority ? "eager" : "lazy"} decoding="async" fetchpriority={priority ? "high" : "auto"} {...imgAttrs} />
    <figcaption class="photo__credit">{credit}</figcaption>
  </figure>
) : (
  <Picture src={src} alt={decorative ? "" : alt} formats={["avif", "webp"]} fallbackFormat={fallbackFormat} quality={72} width={Math.max(...finalWidths)} widths={finalWidths} sizes={sizes}
    loading={priority ? "eager" : "lazy"} decoding="async" fetchpriority={priority ? "high" : "auto"} class={cls} {...imgAttrs} />
)}

<style>
  .photo { position: relative; margin: 0; }
  .photo__credit { position: absolute; inset: auto 0 0 auto; font-size: 11px; line-height: 1.4; padding: 2px 8px; color: #fff; background: rgba(0,0,0,.45); border-start-start-radius: 6px; }
</style>
