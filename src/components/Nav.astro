---
import Icon from "./Icon.astro";
import { site, whatsappLink } from "../config/site";
const current = Astro.url.pathname;
const isCurrent = (href: string) => href.split("#")[0] === current;
---
<nav class="nav" id="nav" aria-label="ניווט ראשי">
  <div class="container nav__inner">
    <a href="/services.html" class="nav__logo" aria-label={`${site.name} - עמוד ראשי`}>
      <img src="/logo.png" alt={site.name} width="140" height="70" />
    </a>

    <ul class="nav__links">
      {site.nav.map(item => (
        <li>
          <a href={item.href} class:list={["nav__link", { "nav__link--packages": item.badge }]} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.badge ? (<><Icon name="layers" class="nav__packages-icon" /><span>{item.label}</span><span class="nav__packages-badge">{item.badge}</span></>) : item.label}
          </a>
        </li>
      ))}
      <li>
        <a href={site.community.href} class="nav__link nav__link--community">
          <Icon name="mail" class="nav__community-icon" /><span>{site.community.label}</span>
        </a>
      </li>
    </ul>

    <div class="nav__mobile-actions">
      <a href={site.social.facebook} class="nav__facebook-mobile" target="_blank" rel="noopener noreferrer" aria-label={`עמוד הפייסבוק של ${site.name}`}>
        <Icon name="facebook" class="icon-fb" />
      </a>
      <a href={whatsappLink("היי, אני רוצה לשמוע על תכנון טיול!")} class="nav__whatsapp-mobile" aria-label="שלחו הודעת וואטסאפ">
        <Icon name="whatsapp" />
      </a>
      <button class="nav__hamburger" id="hamburgerBtn" type="button" aria-label="פתח תפריט" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Outside <nav> on purpose: iOS Safari positions fixed children of a nav with backdrop-filter relative to the nav, which clipped the menu. -->
<div class="nav__mobile-menu" id="mobileMenu" aria-label="תפריט נייד" hidden>
  {site.nav.map((item, i) => (
    <>
      {i === 3 && <div class="mob-nav-sep" role="separator"></div>}
      <a href={item.href} class:list={["mob-nav-item", { "mob-nav-item--tips": item.icon === "tips" }]}>
        <div class:list={["mob-nav-item__icon", { "mob-nav-item__icon--packages": item.icon === "packages" }]}><Icon name={item.icon as "tips"} /></div>
        <div class="mob-nav-item__body">
          <span class="mob-nav-item__title">{item.label}</span>
          {item.sub && <span class="mob-nav-item__sub">{item.sub}</span>}
        </div>
      </a>
    </>
  ))}
  <a href={site.community.href} class="mob-nav-community">
    <div class="mob-nav-community__icon"><Icon name="mail" /></div>
    <div class="mob-nav-community__body">
      <span class="mob-nav-community__title">{site.community.label}</span>
      <span class="mob-nav-community__sub">{site.community.sub}</span>
    </div>
  </a>
</div>

<script>
  const nav = document.getElementById("nav");
  const btn = document.getElementById("hamburgerBtn");
  const menu = document.getElementById("mobileMenu");
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    menu.hidden = !open;
    menu.classList.toggle("open", open);
    btn.classList.toggle("open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "סגור תפריט" : "פתח תפריט");
    document.documentElement.classList.toggle("nav-open", open);
    document.body.classList.toggle("nav-open", open);
  };
  btn?.addEventListener("click", () => setOpen(menu?.hidden ?? true));
  menu?.addEventListener("click", e => { if ((e.target as HTMLElement).closest("a")) setOpen(false); });
  document.addEventListener("keydown", e => { if (e.key === "Escape" && menu && !menu.hidden) { setOpen(false); btn?.focus(); } });
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 10);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
