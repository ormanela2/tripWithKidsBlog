---
/**
 * A page carried over as it is (W6 guides, W7 tools, W8 partner pages): the live page body, its own
 * styles and scripts (src/carried/<slug>/), inside the shared layout (menu, footer, SEO, analytics).
 * Photos the page names (in markup, styles or scripts) are swapped for compressed versions from src/assets/photos.
 * Written by scripts/carry-over.mjs.
 */
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import { breadcrumb, article } from "../../lib/schema";

type Props =
  | { kind: "guide"; entry: CollectionEntry<"htmlGuides"> }
  | { kind: "page"; entry: CollectionEntry<"htmlPages"> };
const { kind, entry } = Astro.props;
const g = entry.data;
const slug = entry.id;
const path = `/${slug}.html`;

const bodies = import.meta.glob<string>("../../carried/*/body.html", { query: "?raw", import: "default", eager: true });
const styles = import.meta.glob<string>("../../carried/*/page.css", { query: "?raw", import: "default", eager: true });
const scriptSets = import.meta.glob<{ src?: string; code?: string }[]>("../../carried/*/scripts.json", { import: "default", eager: true });
// Each page lists the photos it uses (src/carried/<slug>/photos.ts), so only those reach the build.
const photoLists = import.meta.glob<Record<string, ImageMetadata>>("../../carried/*/photos.ts", { import: "default", eager: true });

const key = (file: string) => `../../carried/${slug}/${file}`;
let body = bodies[key("body.html")];
let css = styles[key("page.css")] ?? "";
let scripts = scriptSets[key("scripts.json")] ?? [];
if (!body) throw new Error(`Carried-over page "${slug}": src/carried/${slug}/body.html is missing. Run scripts/carry-over.mjs.`);

// Swap every photo the page names for one compressed WebP.
const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const sizes = new Map<string, { w: number; h: number }>();
const all = `${body}\n${css}\n${scripts.map(s => s.code ?? "").join("\n")}`;
const photos = photoLists[key("photos.ts")] ?? {};
for (const [name, meta] of Object.entries(photos)) {
  if (!all.includes(name)) continue;
  // Longer side at most 1200px (portrait photos too; enough for a full-screen gallery), never upscaled.
  const scale = Math.min(1, 1200 / Math.max(meta.width, meta.height));
  const keepPng = meta.format === "png";
  const img = await getImage({ src: meta, width: Math.round(meta.width * scale), format: keepPng ? "png" : "webp", ...(keepPng ? {} : { quality: 66 }) });
  sizes.set(img.src, { w: meta.width, h: meta.height });
  // Bare names, ./names, encoded spaces and absolute links to the live site all point to the same file.
  const re = new RegExp(`(?<![\\w/.-])(?:https?://(?:www\\.)?mataytasim\\.co\\.il/|\\./)?${escapeRe(name).replace(/ /g, "(?: |%20)")}(?![\\w.-])`, "g");
  body = body.replace(re, img.src);
  css = css.replace(re, img.src);
  scripts = scripts.map(s => (s.code ? { code: s.code.replace(re, img.src) } : s));
}
// Give our photos their real size when the page left it out: same look, no jump while loading.
body = body.replace(/<img\b[^>]*>/g, tag => {
  const src = tag.match(/\ssrc="([^"]+)"/)?.[1];
  const size = src && sizes.get(src);
  if (!size || /\swidth=/.test(tag)) return tag;
  return tag.replace(/^<img\b/, `<img width="${size.w}" height="${size.h}"`);
});
// Links in the page are relative ("budapest.html"); make them absolute so they work from any path.
body = body.replace(/(href|src|action)="(?!https?:|\/|#|mailto:|tel:|javascript:|data:)([^"]+)"/g, '$1="/$2"');

const share = g.shareImage ? (await getImage({ src: g.shareImage, width: 1200, height: 630, fit: "cover", format: "jpg" })).src : undefined;
const schema =
  kind === "guide"
    ? [
        breadcrumb([{ name: site.name, path: "/" }, { name: "יעדים", path: "/destinations.html" }, { name: g.name ?? g.title, path }]),
        article({ headline: g.title, path, description: g.description, ...(share && { image: share }) }),
      ]
    : [breadcrumb([{ name: site.name, path: "/" }, { name: g.name ?? g.title, path }])];
const country = kind === "guide" ? entry.data.country : undefined;
---
<BaseLayout
  title={g.seoTitle ?? g.title}
  description={g.description}
  image={share}
  imageAlt={g.title}
  type={kind === "guide" ? "article" : "website"}
  schema={schema}
  readProgress={g.readProgress}
  floatNav={g.floatNav}
  clarity={g.clarity}
  stay22={g.stay22}
>
  <style slot="head" is:inline set:html={css}></style>
  <style slot="head" is:inline>
    /* Live pages start under the fixed menu and make room for it themselves; the shared layout pads <main>, so undo that here. */
    .carried { margin-top: calc(-1 * var(--nav-height)); }
  </style>
  <div class="carried" data-good-to-know-country={country}><Fragment set:html={body} /></div>
  <Fragment slot="after">
    {scripts.map(s => (s.src ? <script is:inline src={s.src}></script> : <script is:inline set:html={s.code}></script>))}
  </Fragment>
</BaseLayout>
