---
/**
 * Destination guide, new design (approved 2026-11-28; rules in .claude/skills/site-design).
 * Decision first: photo hero + "trip at a glance", summary, then the route (photo strip + map + day cards),
 * things to do, where to stay (Stay22 map, disclosure beside partner links), tips, good to know, phrasebook.
 * Everything comes from the guide's content file (src/content/guides/<slug>.md); nothing is fetched to show content.
 */
import { render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../Photo.astro";
import FeedbackWidget from "../FeedbackWidget.astro";
import { site, whatsappLink } from "../../config/site";
import { breadcrumb, article, faq as faqSchema } from "../../lib/schema";
import { destinations } from "../../data/destinations";
import goodToKnowData from "../../data/good-to-know.json";

type Props = { entry: CollectionEntry<"guides"> };
const { entry } = Astro.props;
const g = entry.data;
const { Content } = await render(entry);
const path = `/${entry.id}.html`;

const MONTHS = ["ינו׳", "פבר׳", "מרץ", "אפר׳", "מאי", "יוני", "יולי", "אוג׳", "ספט׳", "אוק׳", "נוב׳", "דצמ׳"];
const hub = destinations.find(d => d.id === g.hub);
const flightLabel = hub ? (hub.flightHours === 1.5 ? "כשעה וחצי" : `כ-${hub.flightHours} שעות`) : undefined;
type GoodToKnow = { title_he: string; lead_he?: string; items: { id: string; title_he: string; summary_he: string; tips_url?: string }[] };
const gtk = (goodToKnowData as Record<string, GoodToKnow>)[g.country];
const localUrl = (u: string) => (/^https?:/.test(u) ? u : `/${u.replace(/^\//, "")}`);
const stopsCount = g.days.reduce((n, d) => n + d.stops.length, 0);
const bandOf = (d: (typeof g.days)[number]) => d.band ?? ["var(--dest)", "var(--dest-dark)"];
const credits = g.days.flatMap((d, i) => (d.photo?.credit ? [{ day: i + 1, alt: d.photo.alt, ...d.photo.credit }] : []));
const tipGroups = [...new Set(g.tips.map(t => t.group ?? ""))].map(name => ({ name, tips: g.tips.filter(t => (t.group ?? "") === name) }));
const partnerLinks = g.links.filter(l => l.partner);
const otherLinks = g.links.filter(l => !l.partner);
const phraseCount = g.phrasebook?.groups.reduce((n, grp) => n + grp.phrases.length, 0) ?? 0;

const mapDays = g.days.flatMap((d, i) => (d.map ? [{ id: `day-${i + 1}`, day: i + 1, label: d.map.short ?? d.title, emoji: d.icon ?? "📍", lat: d.map.lat, lng: d.map.lng, color: d.map.color ?? g.color, title: d.map.label ?? d.title }] : []));
const mapData = JSON.stringify({ center: g.map?.center ?? { lat: mapDays[0]?.lat ?? 0, lng: mapDays[0]?.lng ?? 0 }, zoom: g.map?.zoom ?? 10, days: mapDays }).replace(/</g, "\\u003c");

const sections = [
  { id: "why", label: `למה ${g.name} עם ילדים` },
  g.days.length && { id: "days", label: "המסלול יום אחר יום" },
  g.attractions.length && { id: "todo", label: "מה לעשות עם ילדים" },
  (g.stays.length || g.partners.staysMap || g.airport || partnerLinks.length) && { id: "stay", label: "איפה ישנו" },
  g.themeParks && { id: "parks", label: "פארקי שעשועים" },
  g.tips.length && { id: "tips", label: "טיפים חשובים" },
  g.gallery.length && { id: "gallery", label: "גלריית תמונות" },
  gtk && { id: "know", label: gtk.title_he },
  g.faq.length && { id: "faq", label: "שאלות נפוצות" },
].filter(Boolean) as { id: string; label: string }[];

// Full-screen copies: longest side 1200px (portrait photos too), never upscaled.
const galleryFull = await Promise.all(g.gallery.map(async p => ({ src: (await getImage({ src: p.image, width: Math.round(p.image.width * Math.min(1, 1200 / Math.max(p.image.width, p.image.height))), format: "webp", quality: 66 })).src, alt: p.alt })));
const share = await getImage({ src: g.hero.image, width: 1200, height: 630, fit: "cover", format: "jpg" });
const schema = [
  breadcrumb([{ name: site.name, path: "/" }, { name: "יעדים", path: "/destinations.html" }, { name: g.name, path }]),
  article({ headline: g.title, path, description: g.description, image: share.src, datePublished: g.datePublished?.toISOString().slice(0, 10), dateModified: g.dateModified?.toISOString().slice(0, 10) }),
  ...(g.faq.length ? [faqSchema(g.faq)] : []),
];
const planText = g.sidebar?.text ?? `אבנה לכם מסלול מלא ל${g.name}: יום אחר יום, עם הילדים שלכם, התקציב שלכם והתאריכים שלכם.`;
const waText = `היי, קראתי את ${g.title} ויש לי שאלה`;
---
<BaseLayout title={g.seoTitle ?? g.title} description={g.description} image={share.src} imageAlt={g.title} type="article" schema={schema} readProgress floatNav stay22>
  {mapDays.length > 0 && <link slot="head" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />}

  <div class="gd" style={`--dest:${g.color};--dest-dark:${g.colorDark ?? g.color}`} data-good-to-know-country={g.country}>
    <div class="container">
      <header class="hero">
        <Photo src={g.hero.image} alt={g.hero.alt || ""} decorative={!g.hero.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1200px) 100vw, 1160px" priority class="hero__img" />
        <div class="hero__inner">
          <div>
            <nav class="crumbs" aria-label="מיקום באתר"><a href="/destinations.html">יעדים</a><span aria-hidden="true">›</span><span>{g.name}</span></nav>
            <h1>{g.title}</h1>
            {g.hero.subtitle && <p class="hero__sub">{g.hero.subtitle}</p>}
            <div class="hero__ctas">
              <a class="btn btn--amber" href="/packages.html">לתכנון טיול כזה</a>
              <a class="btn btn--ghost" href={whatsappLink(waText)} target="_blank" rel="noopener">שאלה בוואטסאפ</a>
            </div>
          </div>
          <section class="glance" aria-labelledby="glance-title">
            <h2 id="glance-title">הטיול בקצרה</h2>
            <dl>
              <div><dt>משך</dt><dd>{g.trip.days} ימים</dd></div>
              {g.trip.dates && <div><dt>תאריכי הטיול</dt><dd>{g.trip.dates}</dd></div>}
              {g.trip.base && <div><dt>בסיס</dt><dd>{g.trip.base}</dd></div>}
              {(g.trip.flight || flightLabel) && <div><dt>טיסה</dt><dd>{[g.trip.flight, flightLabel].filter(Boolean).join(" · ")}</dd></div>}
              {g.kidsAges && <div><dt>גילאי הילדים</dt><dd>{g.kidsAges}</dd></div>}
            </dl>
            {g.bestMonths.length > 0 && (
              <div>
                <p class="glance__label">מתי הכי כדאי</p>
                <div class="months" role="img" aria-label={`חודשים מומלצים: ${g.bestMonths.map(m => MONTHS[m - 1]).join(", ")}`}>
                  {MONTHS.map((m, i) => <span class={g.bestMonths.includes(i + 1) ? "on" : undefined}>{m}</span>)}
                </div>
              </div>
            )}
          </section>
        </div>
        {g.hero.osmCredit && <p class="hero__credit">מפה: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a></p>}
      </header>

      <div class="layout">
        <div class="main">
          <section id="why" class="section" aria-labelledby="why-h">
            <h2 id="why-h">למה {g.name} עם ילדים</h2>
            <div class="summary">
              <div class="story" id="story"><Content /></div>
              <button type="button" class="more" id="storyMore" hidden aria-expanded="false">להמשך הסיפור ↓</button>
              {g.highlights.length > 0 && (
                <>
                  <p class="glance__label">לא לפספס</p>
                  <ul class="chips" aria-label="לא לפספס">{g.highlights.map(h => <li>{h}</li>)}</ul>
                </>
              )}
            </div>
          </section>

          {g.days.length > 0 && (
            <section id="days" class="section" aria-labelledby="days-h">
              <h2 id="days-h">המסלול יום אחר יום</h2>
              <p class="lede">{g.days.length} ימים, {stopsCount} עצירות. כל יום מתקפל: הכותרת אומרת מה עושים, והפרטים נפתחים בלחיצה.</p>

              <div class="route">
                <div class="route__head"><h3>המסלול במבט אחד</h3><span class="route__hint">לחצו על יום כדי לפתוח אותו</span></div>
                <div class="route__scroll">
                  <ol>
                    {g.days.map((d, i) => (
                      <li>
                        <button type="button" class="stopbtn" data-day={i} style={`--band:${bandOf(d)[0]}`} aria-label={`יום ${i + 1}: ${d.map?.short ?? d.title}`}>
                          {d.photo ? (
                            <span class="stopbtn__ring" aria-hidden="true"><Photo src={d.photo.image} alt="" decorative widths={[256, 320]} sizes="128px" /></span>
                          ) : (
                            <span class="stopbtn__ring stopbtn__ring--empty" aria-hidden="true"><span>{d.icon ?? "📍"}</span></span>
                          )}
                          <span class="stopbtn__day">יום {i + 1}</span>
                          <span class="stopbtn__name">{d.map?.short ?? d.title}</span>
                          {(d.map?.date ?? d.date) && <span class="stopbtn__date">{d.map?.date ?? d.date}</span>}
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>
                {credits.length > 0 && (
                  <p class="credits">תמונות: {credits.map(c => <><a href={c.url} target="_blank" rel="noopener">יום {c.day}: {c.alt} · {c.author} · {c.license}</a>{" "}</>)}</p>
                )}
              </div>

              {mapDays.length > 0 && (
                <div class="mapbox">
                  <div id="trip-map" class="map" role="region" aria-label={`מפת המסלול ב${g.name}`}></div>
                </div>
              )}

              <div class="days-head"><button type="button" class="more" id="toggleAll">פתיחת כל הימים</button></div>
              <ol class="days">
                {g.days.map((d, i) => (
                  <li class="day" style={`--band:${bandOf(d)[0]};--band2:${bandOf(d)[1]}`}>
                    <span class="day__dot" aria-hidden="true">{d.icon ?? i + 1}</span>
                    <div class="day__card" id={`day-${i + 1}`}>
                      <div class="day__band"></div>
                      <div class="day__top">
                        <button type="button" class="day__btn" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`day-body-${i + 1}`}>
                          <span class="day__meta">
                            <b>יום {i + 1}</b>
                            {d.date && <span>{d.date}</span>}
                            <span>· {d.stops.length} עצירות</span>
                            {d.badge && <span class="badge" style={d.badgeStyle ? `background:${d.badgeStyle.bg};color:${d.badgeStyle.color}` : undefined}>{d.badge}</span>}
                          </span>
                          <span class="day__title">{d.title}</span>
                          <span class="day__peek">{[d.where, d.stops.slice(0, 3).map(s => s.title).join(" · ")].filter(Boolean).join(" · ")}</span>
                          <span class="day__chev" aria-hidden="true">{i === 0 ? "▲" : "▾"}</span>
                        </button>
                        {d.photo && <Photo src={d.photo.image} alt={d.photo.alt} widths={[192, 288]} sizes="96px" class="day__thumb" />}
                      </div>
                      <div class="day__body" id={`day-body-${i + 1}`} hidden={i !== 0}>
                        {d.stops.map(s => (
                          <div class="stop"><span class="stop__t">{s.time}</span><div><b>{s.title}</b>{s.text && <p>{s.text}</p>}</div></div>
                        ))}
                        {d.tips.map(t => <p class="note">טיפ: {t}</p>)}
                        {d.stay && <p class="note note--stay">לינה: {d.stay}</p>}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {g.attractions.length > 0 && (
            <section id="todo" class="section" aria-labelledby="todo-h">
              <h2 id="todo-h">{g.headings.attractions.title}</h2>
              <ul class="places">
                {g.attractions.map(a => (
                  <li class="place">
                    <span class="place__icon" aria-hidden="true">{a.icon ?? "📍"}</span>
                    <h3>{a.url ? <a href={a.url}>{a.name}</a> : a.name}</h3>
                    {a.text && <p>{a.text}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {(g.stays.length > 0 || g.partners.staysMap || g.airport || partnerLinks.length > 0) && (
            <section id="stay" class="section" aria-labelledby="stay-h">
              <h2 id="stay-h">איפה ישנו</h2>
              {g.staysIntro && <p class="lede">{g.staysIntro}</p>}
              {g.partners.staysMap && (
                <div>
                  <div class="staymap"><iframe src={g.partners.staysMap} title={`מפת מלונות ב${g.name}`} loading="lazy"></iframe></div>
                  <p class="disclose">ⓘ מפת המלונות כוללת קישורי שותפים: אם תזמינו דרכה נקבל עמלה קטנה. המחיר שלכם לא משתנה.</p>
                </div>
              )}
              {g.stays.map(s => (
                <div class="stay">
                  <div class="stay__row">
                    <div><h3>{s.name}</h3>{s.text && <p class="lede">📍 {s.text}</p>}</div>
                    {s.url && <a class="btn btn--teal" href={s.url} target="_blank" rel={s.partner ? "sponsored noopener" : "noopener"}>בדיקת זמינות ←</a>}
                  </div>
                  {s.partner && <p class="disclose">ⓘ קישור שותפים: אם תזמינו דרכו נקבל עמלה קטנה. המחיר שלכם לא משתנה.</p>}
                </div>
              ))}
              {g.airport && (
                <div class="stay stay--soft">
                  <div class="stay__row">
                    <div><h3>🛬 לינה ליד שדה התעופה</h3><p class="lede">{g.airport.text}</p></div>
                    <a class="btn btn--ghost-teal" href={g.airport.url}>{g.airport.label}</a>
                  </div>
                </div>
              )}
              {partnerLinks.map(l => (
                <div class="stay stay--soft">
                  <div class="stay__row">
                    <div><h3>{l.icon} {l.title}</h3>{l.text && <p class="lede">{l.text}</p>}</div>
                    <a class="btn btn--ghost-teal" href={l.url} target={l.url.startsWith("http") ? "_blank" : undefined} rel={l.partner ? "sponsored noopener" : "noopener"}>{l.label}</a>
                  </div>
                  {l.partner && <p class="disclose">ⓘ קישור שותפים: אם תזמינו דרכו נקבל עמלה קטנה. המחיר שלכם לא משתנה.</p>}
                </div>
              ))}
            </section>
          )}

          {g.themeParks && (
            <section id="parks" class="section" aria-labelledby="parks-h">
              <h2 id="parks-h">🎢 פארקי שעשועים</h2>
              {g.themeParks.intro && <p class="lede">{g.themeParks.intro}</p>}
              <div class="parksmap"><iframe src={`/theme-parks.html?cc=${g.themeParks.cc}&embed=map`} title={`מפת פארקי שעשועים: ${g.name}`} loading="lazy"></iframe></div>
              <a class="more" href="/theme-parks.html">למדריך פארקי אירופה המלא ←</a>
            </section>
          )}

          {g.tips.length > 0 && (
            <section id="tips" class="section" aria-labelledby="tips-h">
              <h2 id="tips-h">טיפים חשובים</h2>
              {tipGroups.map(grp => (
                <div class="tipgroup">
                  {grp.name && <h3>{grp.name}</h3>}
                  <ul class="tips">{grp.tips.map(t => <li><span aria-hidden="true">{t.icon ?? "•"}</span><span>{t.text}</span></li>)}</ul>
                </div>
              ))}
              {otherLinks.map(l => (
                <a class="linkcard" href={l.url}>
                  <span class="linkcard__icon" aria-hidden="true">{l.icon}</span>
                  <span><b>{l.title}</b>{l.text && <span class="linkcard__text">{l.text}</span>}</span>
                  <span class="linkcard__go">{l.label}</span>
                </a>
              ))}
            </section>
          )}

          {g.gallery.length > 0 && (
            <section id="gallery" class="section" aria-labelledby="gallery-h">
              <h2 id="gallery-h">📸 גלריית תמונות</h2>
              <ul class="gallery">
                {g.gallery.map((p, i) => (
                  <li><button type="button" class="gallery__item" data-index={i} aria-label={`הגדלת תמונה: ${p.alt}`}><Photo src={p.image} alt={p.alt} widths={[320, 480, 640]} sizes="(max-width: 600px) 50vw, 240px" /></button></li>
                ))}
              </ul>
            </section>
          )}

          {gtk && (
            <section id="know" class="section" aria-labelledby="know-h">
              <h2 id="know-h">{gtk.title_he}</h2>
              {gtk.lead_he && <p class="lede">{gtk.lead_he}</p>}
              <div class="gtk">
                {gtk.items.map(it => (
                  <article><h3>{it.title_he}</h3><p>{it.summary_he}</p>{it.tips_url && <a href={localUrl(it.tips_url)}>להרחבה ←</a>}</article>
                ))}
              </div>
              {g.phrasebook && <button type="button" class="btn btn--teal" data-open-pb>🗣️ {g.phrasebook.title} ({phraseCount} ביטויים)</button>}
            </section>
          )}

          {g.faq.length > 0 && (
            <section id="faq" class="section" aria-labelledby="faq-h">
              <h2 id="faq-h">שאלות נפוצות</h2>
              {g.faq.map(f => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
            </section>
          )}

          {g.feedbackForm && <FeedbackWidget formId={g.feedbackForm} page={entry.id} />}

          <section class="closing">
            <h2>רוצים טיול כזה, מותאם אליכם?</h2>
            <p>{planText}</p>
            <a class="btn btn--amber" href="/packages.html">לחבילות התכנון</a>
          </section>
        </div>

        <aside class="rail">
          <nav class="toc" aria-label="בעמוד הזה">
            <p class="toc__label">בעמוד הזה</p>
            <ol>{sections.map(s => <li><a href={`#${s.id}`} data-id={s.id}>{s.label}</a></li>)}</ol>
          </nav>
          <div class="rail__help">
            <h3>{g.sidebar?.title ?? "רוצים מסלול מותאם?"}</h3>
            <p>{planText}</p>
            <a class="btn btn--amber" href="/packages.html">לחבילות התכנון</a>
            <a class="btn btn--wa" href={whatsappLink(`אני מתעניין בטיול ל${g.name} עם ילדים`)} target="_blank" rel="noopener">וואטסאפ</a>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <Fragment slot="after">
    <div class="gd-actionbar"><a class="btn btn--wa" href={whatsappLink(waText)} target="_blank" rel="noopener">שאלה בוואטסאפ</a><a class="btn btn--teal" href="/packages.html">לתכנון טיול כזה</a></div>
    {g.phrasebook && (
      <>
        <button type="button" class="gd-pbfab" data-open-pb aria-label={g.phrasebook.title} title={g.phrasebook.title}>🗣️</button>
        <div class="gd-sheet" id="pbSheet" hidden>
          <div class="gd-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="pbTitle">
            <div class="gd-sheet__head"><h2 id="pbTitle">{g.phrasebook.title}</h2><button type="button" class="gd-sheet__close" id="pbClose" aria-label="סגירה">✕</button></div>
            <div class="gd-cats" role="group" aria-label="קטגוריות">
              <button type="button" data-cat="all" aria-pressed="true">הכל</button>
              {g.phrasebook.groups.map(grp => <button type="button" data-cat={grp.id} aria-pressed="false">{grp.name}</button>)}
            </div>
            {g.phrasebook.groups.map(grp => (
              <div class="gd-pbgroup" data-cat={grp.id}>
                <h3>{grp.name}</h3>
                {grp.phrases.map(p => <div class="gd-phr"><span>{p.he}</span><span>{p.say}<small lang="und">{p.local}</small></span></div>)}
                {grp.note && <p class="note">מספרי חירום: {grp.note}</p>}
              </div>
            ))}
          </div>
        </div>
      </>
    )}
    {g.gallery.length > 0 && (
      <div class="gd-lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="גלריית תמונות">
        <button type="button" class="gd-lightbox__close" id="lbClose" aria-label="סגירה">✕</button>
        <button type="button" class="gd-lightbox__nav gd-lightbox__prev" id="lbPrev" aria-label="התמונה הקודמת">›</button>
        <img id="lbImg" alt="" />
        <button type="button" class="gd-lightbox__nav gd-lightbox__next" id="lbNext" aria-label="התמונה הבאה">‹</button>
        <script type="application/json" id="galleryData" set:html={JSON.stringify(galleryFull).replace(/</g, "\\u003c")} />
      </div>
    )}
    {mapDays.length > 0 && <script type="application/json" id="tripMapData" set:html={mapData} />}
  </Fragment>
</BaseLayout>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const reduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---- story: first paragraph, rest on request (all visible without script) ----
  (() => {
    const story = $("story"), more = $("storyMore");
    if (!story || !more) return;
    const rest = [...story.querySelectorAll("p")].slice(1);
    if (!rest.length) return;
    rest.forEach(p => (p.hidden = true));
    more.hidden = false;
    more.addEventListener("click", () => {
      const open = more.getAttribute("aria-expanded") === "true";
      rest.forEach(p => (p.hidden = open));
      more.setAttribute("aria-expanded", String(!open));
      more.textContent = open ? "להמשך הסיפור ↓" : "פחות ↑";
    });
  })();

  // ---- day cards, route strip, open all ----
  const btns = [...document.querySelectorAll<HTMLButtonElement>(".day__btn")];
  const cards = [...document.querySelectorAll<HTMLElement>(".day__card")];
  const stops = [...document.querySelectorAll<HTMLButtonElement>(".stopbtn")];
  const setOpen = (i: number, open: boolean) => {
    const b = btns[i]; if (!b) return;
    const body = $(b.getAttribute("aria-controls") || ""); if (body) body.hidden = !open;
    b.setAttribute("aria-expanded", String(open));
    const chev = b.querySelector(".day__chev"); if (chev) chev.textContent = open ? "▲" : "▾";
  };
  btns.forEach((b, i) => b.addEventListener("click", () => setOpen(i, b.getAttribute("aria-expanded") !== "true")));
  function openDay(i: number, scroll: boolean) {
    setOpen(i, true);
    cards.forEach((c, j) => c.classList.toggle("is-active", j === i));
    stops.forEach((s, j) => (j === i ? s.setAttribute("aria-current", "true") : s.removeAttribute("aria-current")));
    if (scroll) cards[i]?.scrollIntoView({ behavior: reduce() ? "auto" : "smooth", block: "center" });
  }
  stops.forEach(s => s.addEventListener("click", () => openDay(Number(s.dataset.day), true)));
  let allOpen = false;
  $("toggleAll")?.addEventListener("click", e => {
    allOpen = !allOpen;
    btns.forEach((_, i) => setOpen(i, allOpen));
    (e.currentTarget as HTMLElement).textContent = allOpen ? "סגירת כל הימים" : "פתיחת כל הימים";
  });

  // ---- contents rail: highlight the section being read ----
  (() => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
    if (!links.length || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(es => es.forEach(e => {
      if (!e.isIntersecting) return;
      links.forEach(a => { const on = a.dataset.id === e.target.id; a.classList.toggle("is-current", on); on ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current"); });
    }), { rootMargin: "-30% 0px -60% 0px" });
    links.forEach(a => { const s = $(a.dataset.id || ""); if (s) io.observe(s); });
  })();

  // ---- route map (Leaflet + CARTO, as on the live guides), loads when near the screen ----
  (() => {
    const el = $("trip-map"), dataEl = $("tripMapData");
    if (!el || !dataEl) return;
    type Day = { id: string; day: number; label: string; emoji: string; lat: number; lng: number; color: string; title: string };
    const data = JSON.parse(dataEl.textContent || "{}") as { center: { lat: number; lng: number }; zoom: number; days: Day[] };
    const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const load = () => new Promise<void>((res, rej) => {
      if ((window as unknown as { L?: unknown }).L) return res();
      const s = document.createElement("script"); s.src = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"; s.onload = () => res(); s.onerror = rej; document.head.appendChild(s);
    });
    const start = () => load().then(() => {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const L = (window as any).L;
      const map = L.map(el, { center: [data.center.lat, data.center.lng], zoom: data.zoom, scrollWheelZoom: false });
      L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", { attribution: "© OpenStreetMap © CARTO", maxZoom: 18 }).addTo(map);
      L.polyline(data.days.map(d => [d.lat, d.lng]), { color: "#E8A045", weight: 2.5, dashArray: "6,5", opacity: 0.8 }).addTo(map);
      const bounds: [number, number][] = [];
      data.days.forEach(d => {
        bounds.push([d.lat, d.lng]);
        const icon = L.divIcon({ className: "", iconSize: [40, 40], iconAnchor: [20, 20], html: `<div style="width:40px;height:40px;border-radius:50%;background:#fff;border:3px solid ${d.color};display:grid;place-items:center;font:700 14px Rubik,sans-serif;color:#124d52;box-shadow:0 3px 10px rgba(0,0,0,.2)">${d.day}</div>` });
        const popup = document.createElement("div");
        popup.dir = "rtl"; popup.style.cssText = "font-family:Rubik,sans-serif;min-width:150px";
        popup.innerHTML = `<div style="font-size:12px;color:#777">יום ${d.day}</div><div style="font-weight:600;color:${d.color}">${esc(d.emoji)} ${esc(d.label)}</div><div style="font-size:13px;color:#555;margin:2px 0 8px">${esc(d.title)}</div>`;
        const go = document.createElement("button");
        go.type = "button"; go.textContent = "לפרטי היום ↓";
        go.style.cssText = `width:100%;background:${d.color};color:#fff;border:0;border-radius:8px;padding:6px;font:600 12px Rubik,sans-serif;cursor:pointer`;
        go.addEventListener("click", () => { map.closePopup(); openDay(d.day - 1, true); });
        popup.appendChild(go);
        L.marker([d.lat, d.lng], { icon }).addTo(map).bindPopup(popup);
      });
      if (bounds.length > 1) map.fitBounds(bounds, { padding: [30, 30] });
    }).catch(() => { el.textContent = "המפה לא נטענה כרגע."; });
    if ("IntersectionObserver" in window) { const io = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: "400px" }); io.observe(el); }
    else start();
  })();

  // ---- gallery lightbox ----
  (() => {
    const box = $("lightbox"), img = $<HTMLImageElement>("lbImg"), dataEl = $("galleryData");
    if (!box || !img || !dataEl) return;
    const items = JSON.parse(dataEl.textContent || "[]") as { src: string; alt: string }[];
    let at = 0, opener: HTMLElement | null = null;
    const show = (i: number) => { at = (i + items.length) % items.length; img.src = items[at]!.src; img.alt = items[at]!.alt; };
    const close = () => { box.hidden = true; document.body.style.overflow = ""; opener?.focus(); };
    document.querySelectorAll<HTMLButtonElement>(".gallery__item").forEach(b => b.addEventListener("click", () => { opener = b; show(Number(b.dataset.index)); box.hidden = false; document.body.style.overflow = "hidden"; $("lbClose")?.focus(); }));
    $("lbClose")?.addEventListener("click", close);
    $("lbPrev")?.addEventListener("click", () => show(at - 1));
    $("lbNext")?.addEventListener("click", () => show(at + 1));
    box.addEventListener("click", e => { if (e.target === box) close(); });
    document.addEventListener("keydown", e => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(at + 1);
      else if (e.key === "ArrowRight") show(at - 1);
    });
  })();

  // ---- phrasebook sheet ----
  (() => {
    const sheet = $("pbSheet"), close = $("pbClose");
    if (!sheet) return;
    let opener: HTMLElement | null = null;
    const open = (from: HTMLElement) => { opener = from; sheet.hidden = false; document.body.style.overflow = "hidden"; close?.focus(); };
    const shut = () => { sheet.hidden = true; document.body.style.overflow = ""; opener?.focus(); };
    document.querySelectorAll<HTMLElement>("[data-open-pb]").forEach(b => b.addEventListener("click", () => open(b)));
    close?.addEventListener("click", shut);
    sheet.addEventListener("click", e => { if (e.target === sheet) shut(); });
    document.addEventListener("keydown", e => { if (e.key === "Escape" && !sheet.hidden) shut(); });
    sheet.querySelectorAll<HTMLButtonElement>(".gd-cats button").forEach(b => b.addEventListener("click", () => {
      sheet.querySelectorAll(".gd-cats button").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
      sheet.querySelectorAll<HTMLElement>(".gd-pbgroup").forEach(grp => (grp.hidden = b.dataset.cat !== "all" && grp.dataset.cat !== b.dataset.cat));
    }));
  })();
</script>

<style>
