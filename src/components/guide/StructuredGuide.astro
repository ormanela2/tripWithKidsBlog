  .tips li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 8px; background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--r-sm); padding: 10px 14px; }

  .gtk { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(230px, 1fr); gap: 12px; overflow-x: auto; padding-bottom: 6px; scroll-snap-type: x mandatory; }
  .gtk article { scroll-snap-align: start; background: var(--sand); border-radius: var(--r-md); padding: 14px; display: grid; gap: 6px; align-content: start; }
  .gd .gtk h3 { font-size: 1.02rem; }
  .gtk p { font-size: 14.5px; line-height: 1.6; }
  .faq { background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--r-sm); padding: 10px 14px; }
  .faq summary { cursor: pointer; font-weight: 600; }

  .closing { background: linear-gradient(135deg, var(--teal-dark), var(--teal)); color: #fff; border-radius: var(--r-lg); padding: 28px; display: grid; gap: 10px; justify-items: start; }
  .gd .closing h2 { color: #fff; }

  @media (max-width: 960px) {
    .hero__inner { grid-template-columns: 1fr; }
    .layout { grid-template-columns: 1fr; gap: 28px; padding-bottom: 110px; }
    .rail { position: static; order: -1; }
    .rail__help { display: none; }
  }
  @media (max-width: 520px) {
    .hero { min-height: 0; }
    .stop { grid-template-columns: 1fr; gap: 2px; }
    .day__top :global(.day__thumb) { width: 72px; height: 54px; }
    .route li { width: 130px; }
    .stopbtn__ring { width: 112px; height: 80px; }
    .route li + li::before { top: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .stopbtn__ring { transition: none; } }
</style>

<style is:global>
