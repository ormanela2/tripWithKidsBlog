  .stopbtn__ring :global(picture), .stopbtn__ring :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .stopbtn__ring--empty { background: repeating-linear-gradient(135deg, var(--sand) 0 10px, #efe5cc 10px 20px); }
  .stopbtn__day { font-size: 12px; font-weight: 700; color: #fff; background: var(--band, var(--dest)); border-radius: 999px; padding: 0 9px; margin-top: -12px; position: relative; }
