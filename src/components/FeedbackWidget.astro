---
/**
 * "Did you find what you were looking for?" feedback widget, as on the live guides (same look, texts and
 * Plausible events: Feedback, Feedback Sent). Sends to the guide's own Formspree form (feedbackForm in its content file).
 */
type Props = { formId: string; page: string };
const { formId, page } = Astro.props;
---
<section class="feedback-section">
  <div class="feedback-widget" id="feedbackWidget" data-form={formId} data-page={page}>
    <div class="feedback-widget__header">
      <span class="feedback-widget__icon" aria-hidden="true">🗺️</span>
      <p class="feedback-widget__question">מצאתם מה שחיפשתם?</p>
      <p class="feedback-widget__sub">הפידבק שלכם עוזר לנו לשפר את המדריך</p>
    </div>
    <div class="feedback-widget__btns" id="feedbackBtns">
      <button type="button" class="feedback-widget__btn feedback-widget__btn--yes" data-sentiment="yes">
        <Fragment set:html={"<svg class=\"feedback-widget__btn-svg\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M7 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V12C3 11.4696 3.21071 10.9609 3.58579 10.5858C3.96086 10.2107 4.46957 10 5 10H7M7 22L13 22C13.9071 21.9999 14.7822 21.665 15.4607 21.0583C16.1392 20.4515 16.5721 19.6134 16.674 18.712L17.374 12.712C17.4303 12.2017 17.3779 11.6851 17.2206 11.1971C17.0633 10.7091 16.8048 10.2613 16.4626 9.88372C16.1204 9.50611 15.7026 9.20764 15.2373 9.00812C14.772 8.8086 14.2699 8.71287 13.764 8.728L11 8.728V5C11 4.46957 10.7893 3.96086 10.4142 3.58579C10.0391 3.21071 9.53043 3 9 3C8.73478 3 8.48043 3.10536 8.29289 3.29289C8.10536 3.48043 8 3.73478 8 4V8.728L7 10M7 22V10\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> </svg>"} />
        <span>כן, בהחלט!</span>
      </button>
      <button type="button" class="feedback-widget__btn feedback-widget__btn--no" data-sentiment="no">
        <Fragment set:html={"<svg class=\"feedback-widget__btn-svg\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M17 2H19C19.5304 2 20.0391 2.21071 20.4142 2.58579C20.7893 2.96086 21 3.46957 21 4V12C21 12.5304 20.7893 13.0391 20.4142 13.4142C20.0391 13.7893 19.5304 14 19 14H17M17 2L11 2C10.0929 2.00012 9.21776 2.33499 8.53927 2.94174C7.86078 3.54848 7.42788 4.38663 7.326 5.288L6.626 11.288C6.56975 11.7983 6.62212 12.3149 6.77944 12.8029C6.93675 13.2909 7.19524 13.7387 7.53741 14.1163C7.87958 14.4939 8.29738 14.7924 8.76268 14.9919C9.22798 15.1913 9.73013 15.2871 10.236 15.272L13 15.272V19C13 19.5304 13.2107 20.0391 13.5858 20.4142C13.9609 20.7893 14.4696 21 15 21C15.2652 21 15.5196 20.8946 15.7071 20.7071C15.8946 20.5196 16 20.2652 16 20V15.272L17 14M17 2V14\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> </svg>"} />
        <span>לא ממש</span>
      </button>
    </div>
    <div class="feedback-box" id="feedbackBox">
      <label class="feedback-box__title" id="feedbackBoxTitle" for="feedbackText"></label>
      <textarea class="feedback-box__textarea" id="feedbackText" placeholder="כתבו לנו כאן..." rows="3"></textarea>
      <button type="button" class="feedback-box__send" id="feedbackSendBtn">שליחה ←</button>
      <p class="feedback-box__error" id="feedbackError" role="alert" hidden>אירעה שגיאה, נסו שוב.</p>
      <p class="feedback-box__thanks" id="feedbackThanks" role="status">תודה! קיבלנו את המשוב <Fragment set:html={"<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:20px;height:20px;vertical-align:middle;display:inline-block;margin-right:4px;\"> <path d=\"M12 21C12 21 3 15.5 3 9C3 6.23858 5.23858 4 8 4C9.65685 4 11.1068 4.7835 12 6C12.8932 4.7835 14.3431 4 16 4C18.7614 4 21 6.23858 21 9C21 15.5 12 21 12 21Z\" fill=\"#e85d7a\" stroke=\"#e85d7a\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> </svg>"} /></p>
    </div>
  </div>
</section>

<script>
  const w = document.getElementById("feedbackWidget");
  if (w) {
    const page = w.dataset.page || "", formId = w.dataset.form || "";
    const $ = (id: string) => document.getElementById(id);
    const track = (name: string, type: string) => { try { (window as unknown as { plausible?: (n: string, o: object) => void }).plausible?.(name, { props: { type, page } }); } catch { /* never break the page */ } };
    let sentiment = "";
    w.querySelectorAll<HTMLButtonElement>("[data-sentiment]").forEach(b => b.addEventListener("click", () => {
      sentiment = b.dataset.sentiment || "";
      track("Feedback", sentiment === "yes" ? "like" : "dislike");
      const title = $("feedbackBoxTitle");
      if (title) title.textContent = sentiment === "yes" ? "תודה רבה על הפידבק, אשמח לשמוע מה אהבת" : "תודה רבה על הפידבק, אשמח לדעת במה נוכל להשתפר באתר";
      $("feedbackBox")?.classList.add("open");
      w.querySelectorAll<HTMLElement>("[data-sentiment]").forEach(x => x.classList.toggle("dimmed", x !== b));
      setTimeout(() => { $("feedbackBox")?.scrollIntoView({ behavior: "smooth", block: "nearest" }); $("feedbackText")?.focus(); }, 100);
    }));
    $("feedbackSendBtn")?.addEventListener("click", () => {
      const btn = $("feedbackSendBtn") as HTMLButtonElement, text = ($("feedbackText") as HTMLTextAreaElement).value.trim();
      btn.textContent = "שולח..."; btn.disabled = true; $("feedbackError")!.hidden = true;
      fetch(`https://formspree.io/f/${formId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ sentiment: sentiment === "yes" ? "👍 חיובי" : "👎 שלילי", message: text || "(ללא הודעה)", page }),
      })
        .then(r => {
          if (!r.ok) throw new Error("form");
          track("Feedback Sent", sentiment === "yes" ? "like" : "dislike");
          for (const id of ["feedbackSendBtn", "feedbackText", "feedbackBoxTitle"]) { const el = $(id); if (el) el.style.display = "none"; }
          const t = $("feedbackThanks"); if (t) t.style.display = "block";
        })
        .catch(() => { btn.textContent = "שליחה ←"; btn.disabled = false; $("feedbackError")!.hidden = false; });
    });
  }
</script>

<style is:global>
/* Copied from the live guides */
.feedback-section {padding: 48px 24px 56px; background: var(--cream); display: flex; justify-content: center;}
.feedback-widget {background: #fff; border: 1.5px solid var(--sand-dark, #e8ddc4); border-radius: 24px; padding: 36px 36px 32px; max-width: 480px; width: 100%; text-align: center; box-shadow: 0 8px 32px rgba(0,0,0,0.07), 0 1px 4px rgba(0,0,0,0.04); position: relative; overflow: hidden;}
.feedback-widget::before {content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--teal, #1A6B72), #0d8a8f); border-radius: 24px 24px 0 0;}
.feedback-widget__header {margin-bottom: 28px;}
.feedback-widget__icon {display: block; font-size: 36px; margin-bottom: 12px; line-height: 1;}
.feedback-widget__icon img.emoji, .feedback-box__thanks img.emoji {width: 32px !important; height: 32px !important; vertical-align: middle;}
.feedback-widget__question {font-family: var(--font-heading); font-size: 20px; color: var(--charcoal, #2c2c2c); margin: 0 0 8px; line-height: 1.3;}
.feedback-widget__sub {font-size: 13px; color: #999; margin: 0; font-family: var(--font-body);}
.feedback-widget__btns {display: flex; gap: 12px; justify-content: center;}
.feedback-widget__btn {display: flex; align-items: center; justify-content: center; gap: 10px; padding: 13px 28px; border-radius: 40px; border: 2px solid transparent; font-size: 15px; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); flex: 1; max-width: 180px;}
.feedback-widget__btn-svg {width: 20px; height: 20px; flex-shrink: 0; transition: transform 0.2s ease;}
.feedback-widget__btn--yes {background: linear-gradient(135deg, var(--teal, #1A6B72), #0d8a8f); color: #fff; box-shadow: 0 4px 14px rgba(26,107,114,0.25);}
.feedback-widget__btn--yes:hover {transform: translateY(-3px); box-shadow: 0 8px 20px rgba(26,107,114,0.35);}
.feedback-widget__btn--yes:hover .feedback-widget__btn-svg {transform: rotate(-15deg) scale(1.15);}
.feedback-widget__btn--no {background: #fff; color: var(--charcoal, #2c2c2c); border-color: #e0d9cc; box-shadow: 0 2px 8px rgba(0,0,0,0.06);}
.feedback-widget__btn--no:hover {border-color: #bbb; transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.1);}
.feedback-widget__btn--no:hover .feedback-widget__btn-svg {transform: rotate(15deg) scale(1.15);}
.feedback-widget__btn.dimmed {opacity: 0.35; transform: scale(0.97);}
.feedback-box {display: none; margin-top: 24px; padding-top: 24px; border-top: 1.5px solid #f0ebe1; text-align: right; direction: rtl;}
.feedback-box.open {display: block; animation: feedbackSlideIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);}
.feedback-box__title {font-size: 14px; color: #555; margin: 0 0 12px; font-family: var(--font-body); line-height: 1.5; font-weight: 500;}
.feedback-box__textarea {width: 100%; border: 1.5px solid #e0d9cc; border-radius: 14px; padding: 13px 15px; font-family: var(--font-body); font-size: 15px; color: var(--charcoal, #2c2c2c); resize: none; outline: none; box-sizing: border-box; direction: rtl; transition: border-color 0.2s, box-shadow 0.2s; background: #fdfaf6;}
.feedback-box__textarea:focus {border-color: var(--teal, #1A6B72); box-shadow: 0 0 0 3px rgba(26,107,114,0.1); background: #fff;}
.feedback-box__send {margin-top: 12px; width: 100%; background: linear-gradient(135deg, var(--teal, #1A6B72), #0d8a8f); color: #fff; border: none; border-radius: 40px; padding: 13px 24px; font-family: var(--font-body); font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(26,107,114,0.25);}
.feedback-box__send:hover {transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26,107,114,0.35);}
.feedback-box__thanks {display: none; margin-top: 16px; font-size: 16px; color: var(--teal, #1A6B72); font-weight: 600; text-align: center; font-family: var(--font-body);}
.feedback-widget {padding: 28px 22px 26px;}
.feedback-widget__btn {padding: 12px 16px; font-size: 14px;}
@media (max-width: 480px) { .feedback-widget { padding: 28px 22px 26px; } .feedback-widget__btn { padding: 12px 16px; font-size: 14px; } }
.feedback-box__error { font-size: 13px; color: #7f1d1d; margin-top: 8px; }
</style>
