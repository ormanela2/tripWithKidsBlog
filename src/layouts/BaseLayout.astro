---
/**
 * Shared page shell: Hebrew RTL, fonts, SEO tags, analytics, nav, footer, WhatsApp button, back-to-top.
 * The newsletter popup (W10) plugs in here later.
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Seo, { type SeoProps } from "../components/Seo.astro";
import { site, whatsappLink } from "../config/site";

type Props = SeoProps & { readProgress?: boolean; clarity?: boolean; stay22?: boolean };
const { readProgress, clarity, stay22, ...seo } = Astro.props;
const clarityId = clarity ? site.analytics.clarityId : null;
const stay22Id = stay22 ? site.partners.stay22.partnerId : null;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seo} />
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&family=Secular+One&family=Assistant:wght@300;400;600&display=swap" />
    <script defer data-domain={site.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    {clarityId && <script is:inline define:vars={{ clarityId }}>(function (c, l, a, r, i, t, y) { c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); }; t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i; y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y); })(window, document, "clarity", "script", clarityId);</script>}
    {stay22Id && <script is:inline define:vars={{ stay22Id }}>(function (s, t, a, y) { s.Stay22 = s.Stay22 || {}; s.Stay22.params = { lmaID: stay22Id }; var e = t.createElement(a), f = t.getElementsByTagName(a)[0]; e.async = 1; e.src = y; f.parentNode.insertBefore(e, f); })(window, document, "script", "https://scripts.stay22.com/letmeallez.js");</script>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן</a>
    <Nav readProgress={readProgress} />
    <main id="main"><slot /></main>
    <Footer />
    <slot name="after" />
    <a href={whatsappLink("היי, אני רוצה לשמוע על תכנון טיול!")} class="wa-float" aria-label="שלחו לנו הודעת וואטסאפ"><Icon name="whatsapp" /></a>
    <button type="button" class="to-top" id="toTop" aria-label="חזרה לראש העמוד"><Icon name="up" /></button>
    <script>
      const toTop = document.getElementById("toTop");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.addEventListener("scroll", () => toTop?.classList.toggle("visible", window.scrollY > 600), { passive: true });
      toTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" }));
    </script>
  </body>
</html>

<style is:global>
  .skip-link { position: absolute; right: 12px; top: -48px; z-index: 2000; background: var(--teal); color: #fff; padding: 8px 14px; border-radius: var(--radius-sm); }
  .skip-link:focus { top: 12px; }
</style>
