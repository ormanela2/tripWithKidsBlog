---
/**
 * Destinations hub. Fully static: no API calls (the old page fetched live currency rates).
 * Filters, the flight strip and the quick-look dialog run on the page's own data.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { destinations, seasonFilters, lengthFilters, styleFilters, articles } from "../data/destinations";
import { site, whatsappLink } from "../config/site";

const MAX_H = 4.5;
const flightLabel = (h: number) => (h === 1.5 ? "כשעה וחצי" : `כ-${h} שעות`);
const byHours = [...new Set(destinations.map(d => d.flightHours))].sort((a, b) => a - b)
  .map(h => ({ h, left: (h / MAX_H) * 100, items: destinations.filter(d => d.flightHours === h) }));
const ticks = [0, 1, 2, 3, 4].map(h => ({ h, left: (h / MAX_H) * 100, label: h === 0 ? "תל אביב" : h === 1 ? "שעה" : h === 2 ? "שעתיים" : `${h} שעות` }));
const data = JSON.stringify(destinations.map(d => ({ ...d, flight: flightLabel(d.flightHours) }))).replace(/</g, "\\u003c");
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "יעדים לטיול משפחתי באירופה",
  itemListElement: destinations.map((d, i) => ({ "@type": "ListItem", position: i + 1, name: `${d.name} עם ילדים`, url: `${site.url}${d.url}` })),
}).replace(/</g, "\\u003c");
---
<BaseLayout title="יעדים לטיול עם ילדים - מתי טסים" description="9 יעדים לטיול משפחתי באירופה: כמה ימים, מתי הכי כדאי, כמה זמן טיסה מתל אביב ומה לא לפספס. מדריכים מלאים מטיולים אמיתיים.">
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__eyebrow">{destinations.length} יעדים · טיולים משפחתיים באירופה</span>
      <h1>לאן טסים הפעם?</h1>
      <p class="hero__lede">יעדים שטיילנו בהם עם הילדים, עם כל מה שצריך כדי להחליט: כמה ימים, מתי הכי כדאי, כמה זמן באוויר, ומה לא לפספס.</p>
    </div>
  </section>

  <section class="container finder" aria-labelledby="finder-title">
    <h2 id="finder-title" class="visually-hidden">סינון יעדים</h2>
    <div class="filters" role="group" aria-label="סינון יעדים">
      <div class="filters__group">
        <span class="filters__label">מתי טסים?</span>
        <div class="chips" data-filter="season">
          {seasonFilters.map((f, i) => <button type="button" class="chip" data-value={f.id} aria-pressed={i === 0 ? "true" : "false"}>{f.label}</button>)}
        </div>
      </div>
      <div class="filters__group">
        <span class="filters__label">כמה ימים?</span>
        <div class="chips" data-filter="length">
          {lengthFilters.map((f, i) => <button type="button" class="chip" data-value={f.id} aria-pressed={i === 0 ? "true" : "false"}>{f.label}</button>)}
        </div>
      </div>
      <div class="filters__group">
        <span class="filters__label">מה אוהבים?</span>
        <div class="chips" data-filter="style" data-multi>
          {styleFilters.map(f => <button type="button" class="chip" data-value={f.id} aria-pressed="false">{f.label}</button>)}
        </div>
      </div>
      <div class="filters__foot">
        <p class="filters__count" aria-live="polite"><b id="resultCount">{destinations.length}</b> יעדים מתאימים</p>
        <button type="button" class="link-btn" id="resetFilters" hidden>ניקוי סינון</button>
      </div>
    </div>

    <figure class="flight" aria-labelledby="flight-title">
      <figcaption>
        <h2 id="flight-title">כמה זמן באוויר מתל אביב?</h2>
        <p>זמני טיסה ישירה משוערים. לחצו על יעד להצצה מהירה.</p>
      </figcaption>
      <div class="flight__scroll">
        <div class="flight__track">
          <svg class="flight__path" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 990 100 C 760 20, 300 20, 10 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="6 8" vector-effect="non-scaling-stroke" />
          </svg>
          <span class="flight__plane" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
          </span>
          {ticks.map(t => <span class="flight__tick" style={`right:${t.left}%`}><span>{t.label}</span></span>)}
          {byHours.map(g => (
            <div class="flight__stop" style={`right:${g.left}%`}>
              {g.items.map(d => (
                <button type="button" class="pin" data-id={d.id} style={`--c:${d.color}`} aria-label={`${d.name}, ${flightLabel(d.flightHours)} טיסה. הצצה מהירה`}>
                  <span class="pin__dot" aria-hidden="true"></span>{d.name}
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </figure>

    <ul class="grid" id="destGrid">
      {destinations.map((d, i) => (
        <li class="card" data-id={d.id} data-seasons={d.seasons.join(" ")} data-min-days={d.minDays} data-styles={d.styles.join(" ")} style={`--c:${d.color}`}>
          <figure class="card__media">
            <img src={d.image} alt={d.imageAlt} width="640" height="400" loading={i < 3 ? "eager" : "lazy"} decoding="async" />
            <span class="card__flight">✈ {flightLabel(d.flightHours)}</span>
            <figcaption class="card__title"><h3>{d.name}</h3><span>{d.region}</span></figcaption>
          </figure>
          <div class="card__body">
            <dl class="card__stats">
              <div><dt>משך</dt><dd>{d.days}</dd></div>
              <div><dt>עונה</dt><dd>{d.season}</dd></div>
              <div><dt>מטבע</dt><dd>{d.currency.symbol} {d.currency.code}</dd></div>
            </dl>
            <p class="card__desc">{d.desc}</p>
            <ul class="card__tags">{d.tags.slice(0, 3).map(t => <li>{t}</li>)}</ul>
            <div class="card__actions">
              <a class="btn btn--primary" href={d.url}>למדריך המלא ←</a>
              <button type="button" class="btn btn--ghost" data-quick={d.id}>הצצה מהירה</button>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="empty" id="emptyState" hidden>
      <p>אין יעד שמתאים לכל הבחירות.</p>
      <button type="button" class="btn btn--ghost" data-reset>להסיר את הסינון</button>
    </div>
  </section>

  <section class="articles" id="family-articles">
    <div class="container">
      <div class="section-head">
        <h2>המדריכים של מתי טסים: עושים סדר ביעדים</h2>
        <p>חוויות אמיתיות מטיולים משפחתיים באירופה - עם דגשים פרקטיים להורים.</p>
      </div>
      <div class="articles__grid">
        {articles.map(a => a.url ? (
          <a class="article" href={a.url} data-article-card={a.id}>
            <span class="article__read">⏱ {a.read}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <span class="article__more">לקריאת הכתבה המלאה ←</span>
          </a>
        ) : (
          <div class="article article--soon" data-article-card={a.id}>
            <span class="article__read">בקרוב באתר</span>
            <h3>{a.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__inner">
      <h2>הטיול הבא שלכם מתחיל כאן</h2>
      <p>לא בטוחים איזה יעד מתאים לגילאים ולתקציב? נשמח לעזור לבחור ולתכנן.</p>
      <div class="cta__actions">
        <a class="btn btn--amber" href="/packages.html">לחבילות התכנון</a>
        <a class="btn btn--light" href={whatsappLink("היי, אשמח לעזרה בבחירת יעד לטיול עם ילדים")}>שאלה? כתבו לי בוואטסאפ</a>
      </div>
    </div>
  </section>

  <dialog class="quick" id="quick" aria-labelledby="quickName">
    <form method="dialog" class="quick__close-form"><button class="quick__close" aria-label="סגירה">✕</button></form>
    <img class="quick__img" id="quickImg" alt="" width="640" height="360" />
    <div class="quick__body">
      <p class="quick__region" id="quickRegion"></p>
      <h2 id="quickName"></h2>
      <dl class="quick__stats" id="quickStats"></dl>
      <p id="quickDesc"></p>
      <ul class="card__tags" id="quickTags"></ul>
      <div class="quick__actions" id="quickActions"></div>
    </div>
  </dialog>

  <script type="application/json" id="destData" set:html={data} />
</BaseLayout>

<script>
  type D = { id: string; name: string; region: string; url: string; image: string; imageAlt: string; days: string; season: string; flight: string; currency: { code: string; symbol: string }; desc: string; tags: string[]; wa: string };
  const plausible = (name: string, props: Record<string, string>) => { const p = (window as unknown as { plausible?: (n: string, o: object) => void }).plausible; if (p) p(name, { props }); };
  const all: D[] = JSON.parse(document.getElementById("destData")?.textContent || "[]");
  const byId = new Map(all.map(d => [d.id, d]));
  const cards = [...document.querySelectorAll<HTMLElement>(".card")];
  const pins = [...document.querySelectorAll<HTMLElement>(".pin")];
  const state = { season: "any", length: "any", styles: new Set<string>() };
  const LEN: Record<string, [number, number]> = { any: [0, 99], short: [0, 6], week: [7, 9], long: [10, 99] };

  function apply() {
    let n = 0;
    for (const c of cards) {
      const seasons = (c.dataset.seasons || "").split(" "), styles = (c.dataset.styles || "").split(" "), days = Number(c.dataset.minDays);
      const [lo, hi] = LEN[state.length] ?? [0, 99];
      const ok = (state.season === "any" || seasons.includes(state.season) || seasons.includes("all"))
        && days >= lo && days <= hi
        && (state.styles.size === 0 || [...state.styles].some(s => styles.includes(s)));
      c.hidden = !ok;
      pins.find(p => p.dataset.id === c.dataset.id)?.classList.toggle("is-out", !ok);
      if (ok) n++;
    }
    const count = document.getElementById("resultCount"); if (count) count.textContent = String(n);
    const empty = document.getElementById("emptyState"); if (empty) empty.hidden = n > 0;
    const reset = document.getElementById("resetFilters"); if (reset) reset.hidden = state.season === "any" && state.length === "any" && state.styles.size === 0;
  }

  document.querySelectorAll<HTMLElement>(".chips").forEach(group => {
    const key = group.dataset.filter as "season" | "length" | "style";
    group.addEventListener("click", e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".chip"); if (!btn) return;
      const v = btn.dataset.value || "any";
      if (key === "style") {
        state.styles.has(v) ? state.styles.delete(v) : state.styles.add(v);
        btn.setAttribute("aria-pressed", String(state.styles.has(v)));
      } else {
        state[key] = v;
        group.querySelectorAll(".chip").forEach(c => c.setAttribute("aria-pressed", String(c === btn)));
      }
      apply();
    });
  });
  function resetAll() {
    state.season = "any"; state.length = "any"; state.styles.clear();
    document.querySelectorAll<HTMLElement>(".chips").forEach(g => g.querySelectorAll(".chip").forEach((c, i) => c.setAttribute("aria-pressed", String(g.dataset.filter !== "style" && i === 0))));
    apply();
  }
  document.getElementById("resetFilters")?.addEventListener("click", resetAll);
  document.querySelector("[data-reset]")?.addEventListener("click", resetAll);

  // Link the flight strip and the cards: hover or focus one, highlight the other.
  const highlight = (id: string | null) => {
    pins.forEach(p => p.classList.toggle("is-active", p.dataset.id === id));
    cards.forEach(c => c.classList.toggle("is-active", c.dataset.id === id));
  };
  for (const el of [...cards, ...pins]) {
    el.addEventListener("mouseenter", () => highlight(el.dataset.id || null));
    el.addEventListener("mouseleave", () => highlight(null));
    el.addEventListener("focusin", () => highlight(el.dataset.id || null));
    el.addEventListener("focusout", () => highlight(null));
  }

  // Quick look
  const dialog = document.getElementById("quick") as HTMLDialogElement | null;
  const setText = (id: string, t: string) => { const el = document.getElementById(id); if (el) el.textContent = t; };
  function openQuick(id: string, opener?: HTMLElement) {
    const d = byId.get(id); if (!d || !dialog) return;
    const img = document.getElementById("quickImg") as HTMLImageElement; img.src = d.image; img.alt = d.imageAlt;
    setText("quickName", d.name); setText("quickRegion", d.region); setText("quickDesc", d.desc);
    const stats = document.getElementById("quickStats")!; stats.replaceChildren();
    for (const [k, v] of [["משך הטיול", d.days], ["מתי הכי כדאי", d.season], ["זמן טיסה", d.flight], ["מטבע", `${d.currency.symbol} ${d.currency.code}`]]) {
      const box = document.createElement("div"), dt = document.createElement("dt"), dd = document.createElement("dd");
      dt.textContent = k; dd.textContent = v; box.append(dt, dd); stats.append(box);
    }
    const tags = document.getElementById("quickTags")!; tags.replaceChildren(...d.tags.map(t => { const li = document.createElement("li"); li.textContent = t; return li; }));
    const actions = document.getElementById("quickActions")!; actions.replaceChildren();
    const link = (href: string, text: string, cls: string, ext = false) => { const a = document.createElement("a"); a.href = href; a.textContent = text; a.className = `btn ${cls}`; if (ext) { a.target = "_blank"; a.rel = "noopener"; } actions.append(a); };
    link(d.url, "למדריך המלא ←", "btn--primary");
    link(`/family-top-attractions.html#dest-${d.id}`, "5 המקומות הכי שווים", "btn--ghost");
    link(`https://wa.me/972546758145?text=${encodeURIComponent(`היי, אני מתעניין בטיול ל${d.wa} עם ילדים`)}`, "שאלה בוואטסאפ", "btn--wa", true);
    link("/calendar.html", "אירועים קרובים ביעד", "btn--ghost");
    dialog.showModal();
    dialog.addEventListener("close", () => opener?.focus(), { once: true });
    plausible("Destinations-Quick-Look", { destination: d.id });
  }
  document.addEventListener("click", e => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-quick], .pin");
    if (t) openQuick(t.dataset.quick || t.dataset.id || "", t);
  });
  dialog?.addEventListener("click", e => { if (e.target === dialog) dialog.close(); });

  // Same Plausible event as the old page for article cards.
  document.querySelectorAll<HTMLElement>("[data-article-card]").forEach(a => a.addEventListener("click", () => plausible("Destinations-Family-Article-Card-Click", { article: a.dataset.articleCard || "" })));

  apply();
</script>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h1, h2, h3 { font-family: var(--font-heading); font-weight: 400; color: var(--charcoal); text-wrap: balance; line-height: 1.2; }

  .hero { background: radial-gradient(120% 140% at 85% 0%, rgba(26,107,114,.14), transparent 55%), radial-gradient(90% 120% at 0% 100%, rgba(232,160,69,.16), transparent 60%), var(--cream); padding-block: clamp(40px, 7vw, 84px) clamp(28px, 4vw, 44px); }
  .hero__inner { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  .hero__eyebrow { align-self: flex-start; font-size: 14px; font-weight: 600; color: var(--teal); background: rgba(26,107,114,.1); border-radius: 999px; padding: 4px 14px; }
  .hero h1 { font-size: clamp(2.3rem, 6vw, 3.6rem); color: var(--teal-dark); }
  .hero__lede { font-size: 1.12rem; color: #4a4a4a; max-width: 62ch; }

  .finder { display: flex; flex-direction: column; gap: 22px; padding-bottom: 56px; }
  .filters { background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--radius-lg); padding: 18px 20px; box-shadow: var(--shadow-sm); display: grid; gap: 12px; margin-top: -8px; }
  .filters__group { display: grid; grid-template-columns: 96px 1fr; gap: 10px; align-items: center; }
  .filters__label { font-weight: 600; font-size: 14px; color: var(--teal-dark); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { border: 1.5px solid var(--sand-dark); background: var(--cream); color: var(--charcoal); border-radius: 999px; padding: 5px 14px; font-size: 14px; font-weight: 500; transition: background .2s, border-color .2s, color .2s, transform .15s; }
  .chip:hover { border-color: var(--teal); }
  .chip[aria-pressed="true"] { background: var(--teal); border-color: var(--teal); color: #fff; }
  .chip:active { transform: scale(.96); }
  .filters__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px dashed var(--sand-dark); padding-top: 10px; font-size: 14px; color: #555; }
  .filters__count b { color: var(--teal); font-size: 1.1rem; }
  .link-btn { color: var(--teal); font-weight: 600; text-decoration: underline; font-size: 14px; }

  .flight { background: linear-gradient(180deg, #fff, #fdfaf4); border: 1px solid var(--sand-dark); border-radius: var(--radius-lg); padding: 18px 20px 10px; }
  .flight figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .flight h2 { font-size: 1.35rem; color: var(--teal-dark); }
  .flight figcaption p { font-size: 14px; color: #666; }
  .flight__scroll { overflow-x: auto; padding-bottom: 8px; }
  .flight__track { position: relative; min-width: 640px; height: 210px; margin: 8px 34px 0 60px; }
  .flight__path { position: absolute; inset: 70px 0 auto 0; width: 100%; height: 90px; color: rgba(26,107,114,.45); }
  .flight__plane { position: absolute; right: -26px; top: 140px; width: 34px; height: 34px; border-radius: 50%; background: var(--teal); color: #fff; display: grid; place-items: center; box-shadow: var(--shadow-md); transform: rotate(-90deg); }
  .flight__plane svg { width: 18px; height: 18px; }
  .flight__tick { position: absolute; bottom: 0; transform: translateX(50%); height: 28px; border-right: 1px solid var(--sand-dark); }
  .flight__tick span { position: absolute; bottom: -2px; right: 6px; font-size: 12px; color: #777; white-space: nowrap; }
  .flight__stop { position: absolute; bottom: 36px; transform: translateX(50%); display: flex; flex-direction: column-reverse; align-items: center; gap: 6px; }
  .pin { display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1.5px solid color-mix(in srgb, var(--c) 45%, var(--sand-dark)); color: var(--charcoal); border-radius: 999px; padding: 3px 12px 3px 10px; font-size: 13px; font-weight: 600; white-space: nowrap; box-shadow: var(--shadow-sm); transition: transform .18s, box-shadow .18s, opacity .25s, border-color .18s; }
  .pin__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 20%, transparent); }
  .pin:hover, .pin.is-active { transform: translateY(-2px); border-color: var(--c); box-shadow: var(--shadow-md); }
  .pin.is-out { opacity: .28; }

  .grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .card { background: #fff; border: 1px solid var(--sand-dark); border-top: 4px solid var(--c); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: transform .22s, box-shadow .22s; animation: rise .35s ease both; }
  .card:hover, .card.is-active { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .card__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--sand); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover .card__media img { transform: scale(1.05); }
  .card__media::after { content: ""; position: absolute; inset: 40% 0 0 0; background: linear-gradient(180deg, transparent, rgba(0,0,0,.62)); }
  .card__title { position: absolute; z-index: 1; bottom: 12px; right: 16px; left: 16px; color: #fff; display: flex; align-items: baseline; gap: 10px; }
  .card__title h3 { color: #fff; font-size: 1.6rem; }
  .card__title span { font-size: 14px; opacity: .9; }
  .card__flight { position: absolute; z-index: 1; top: 12px; left: 12px; background: rgba(255,255,255,.92); color: var(--teal-dark); font-size: 13px; font-weight: 600; border-radius: 999px; padding: 3px 10px; }
  .card__body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .card__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .card__stats div { background: var(--cream); border-radius: var(--radius-sm); padding: 6px 8px; }
  .card__stats dt { font-size: 11px; color: #777; }
  .card__stats dd { font-size: 13px; font-weight: 600; color: var(--charcoal); line-height: 1.35; }
  .card__desc { font-size: 15px; line-height: 1.6; color: #4a4a4a; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .card__tags li { font-size: 12.5px; background: color-mix(in srgb, var(--c, var(--teal)) 9%, #fff); color: var(--charcoal); border: 1px solid color-mix(in srgb, var(--c, var(--teal)) 22%, #fff); border-radius: 999px; padding: 2px 10px; }
  .card__actions { margin-top: auto; display: flex; gap: 8px; flex-wrap: wrap; }

