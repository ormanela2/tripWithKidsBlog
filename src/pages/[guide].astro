---
/**
 * Destination guide template. One page per file in src/content/guides (published at /<slug>.html).
 * Everything shown comes from the guide's content file; nothing is fetched in the browser.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import PartnerNote from "../components/PartnerNote.astro";
import { site, whatsappLink, googleMapsLink } from "../config/site";
import { breadcrumb, article, faq as faqSchema } from "../lib/schema";
import goodToKnowData from "../data/good-to-know.json";

export async function getStaticPaths() {
  const guides = await getCollection("guides", g => !g.data.draft);
  return guides.map(g => ({ params: { guide: g.id }, props: { entry: g } }));
}

type Props = { entry: CollectionEntry<"guides"> };
const { entry } = Astro.props;
const g = entry.data;
const { Content } = await render(entry);
const path = `/${entry.id}.html`;

const MONTHS = ["ינו׳", "פבר׳", "מרץ", "אפר׳", "מאי", "יוני", "יולי", "אוג׳", "ספט׳", "אוק׳", "נוב׳", "דצמ׳"];
type GoodToKnow = { title_he: string; lead_he?: string; items: { id: string; title_he: string; summary_he: string; tips_url?: string }[] };
const goodToKnow = (goodToKnowData as Record<string, GoodToKnow>)[g.country];
const localUrl = (u?: string) => (!u ? undefined : /^https?:/.test(u) ? u : `/${u.replace(/^\//, "")}`);

const share = await getImage({ src: g.hero.image, width: 1200, height: 630, fit: "cover", format: "jpg" });
const stopsCount = g.days.reduce((n, d) => n + d.stops.length, 0);

const sections = [
  { id: "intro", label: "למה לטוס" },
  g.days.length && { id: "itinerary", label: "מסלול יום-יום" },
  g.stays.length && { id: "stays", label: "לינה" },
  g.attractions.length && { id: "attractions", label: "מה לעשות" },
  g.tips.length && { id: "tips", label: "טיפים" },
  goodToKnow && { id: "good-to-know", label: "טוב לדעת" },
  g.phrasebook && { id: "phrasebook", label: "מילון" },
  g.faq.length && { id: "faq", label: "שאלות" },
].filter(Boolean) as { id: string; label: string }[];

const schema = [
  breadcrumb([{ name: site.name, path: "/" }, { name: "יעדים", path: "/destinations.html" }, { name: g.title, path }]),
  article({
    headline: g.title, path, description: g.description, image: share.src,
    datePublished: g.datePublished?.toISOString().slice(0, 10), dateModified: g.dateModified?.toISOString().slice(0, 10),
  }),
  ...(g.faq.length ? [faqSchema(g.faq)] : []),
];
---
<BaseLayout title={g.seoTitle ?? g.title} description={g.description} image={share.src} imageAlt={g.hero.alt} type="article" schema={schema}>
  <article class="guide" style={`--c:${g.color}`}>
    <header class="hero">
      <Photo src={g.hero.image} alt={g.hero.alt} widths={[640, 960, 1280, 1600]} sizes="100vw" priority class="hero__img" />
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="container hero__inner">
        <nav class="crumbs" aria-label="מיקום באתר"><a href="/destinations.html">יעדים</a><span aria-hidden="true">‹</span><span>{g.title}</span></nav>
        <h1>{g.title}</h1>
        <ul class="hero__facts">
          <li><b>{g.trip.days}</b> ימים</li>
          {g.trip.dates && <li>{g.trip.dates}</li>}
          {g.trip.base && <li>לינה: {g.trip.base}</li>}
          {g.trip.flight && <li>{g.trip.flight}</li>}
          {g.kidsAges && <li>גילאי {g.kidsAges}</li>}
        </ul>
      </div>
    </header>

    <nav class="toc" aria-label="תוכן המדריך">
      <div class="container toc__inner">
        {sections.map(s => <a href={`#${s.id}`}>{s.label}</a>)}
      </div>
    </nav>

    <div class="container layout">
      <div class="main">
        <section id="intro" class="block">
          <h2>למה {g.title.replace(/^טיול ל/, "").replace(/ עם ילדים$/, "")} עם ילדים?</h2>
          <div class="prose"><Content /></div>
        </section>

        {g.days.length > 0 && (
          <section id="itinerary" class="block">
            <h2>מסלול יום-יום</h2>
            <p class="block__lede">{g.days.length} ימים, {stopsCount} עצירות. לחצו על יום כדי לפתוח או לסגור אותו.</p>
            <ol class="days">
              {g.days.map((d, i) => (
                <li class="day">
                  <span class="day__node" aria-hidden="true">{d.icon ?? i + 1}</span>
                  <details class="day__card" open={i === 0}>
                    <summary>
                      <span class="day__num">יום {i + 1}{d.date && <span class="day__date"> · {d.date}</span>}</span>
                      <span class="day__title">{d.title}</span>
                      {d.where && <span class="day__where">{d.where}</span>}
                      {d.badge && <span class="day__badge">{d.badge}</span>}
                    </summary>
                    <div class="day__body">
                      {d.stops.length > 0 && (
                        <ul class="stops">
                          {d.stops.map(s => (
                            <li class="stop">
                              <span class="stop__time">{s.time ?? ""}</span>
                              <div><b>{s.title}</b>{s.text && <p>{s.text}</p>}</div>
                            </li>
                          ))}
                        </ul>
                      )}
                      {d.tips.map(t => <p class="note note--tip"><b>טיפ:</b> {t}</p>)}
                      {d.stay && <p class="note"><b>לינה:</b> {d.stay}</p>}
                      {d.map && <a class="day__maplink" href={googleMapsLink(`${d.map.lat},${d.map.lng}`)} target="_blank" rel="noopener">פתיחה ב-Google Maps ↗</a>}
                    </div>
                  </details>
                </li>
              ))}
            </ol>
          </section>
        )}

        {g.stays.length > 0 && (
          <section id="stays" class="block">
            <h2>איפה ישנו</h2>
            <ul class="cards">
              {g.stays.map(s => (
                <li class="card">
                  <b class="card__name">{s.icon} {s.name}</b>
                  {s.text && <span class="card__text">{s.text}</span>}
                  {s.url && <a class="btn btn--primary" href={s.url} target="_blank" rel={s.partner ? "sponsored noopener" : "noopener"}>לבדיקת זמינות ←</a>}
                </li>
              ))}
            </ul>
            {g.partners.staysMap && (
              <iframe class="stays-map" src={g.partners.staysMap} title={`מפת מלונות: ${g.title}`} loading="lazy" width="100%" height="420"></iframe>
            )}
            {(g.stays.some(s => s.partner) || g.partners.staysMap) && <PartnerNote />}
          </section>
        )}

        {g.attractions.length > 0 && (
          <section id="attractions" class="block">
            <h2>מה לעשות עם ילדים</h2>
            <ul class="grid">
              {g.attractions.map(a => (
                <li class="tile">
                  {a.icon && <span class="tile__icon" aria-hidden="true">{a.icon}</span>}
                  <h3>{a.url ? <a href={a.url}>{a.name}</a> : a.name}</h3>
                  {a.text && <p>{a.text}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {g.tips.length > 0 && (
          <section id="tips" class="block">
            <h2>טיפים חשובים</h2>
            <ul class="tips">
              {g.tips.map(t => <li><span aria-hidden="true">{t.icon ?? "•"}</span><span>{t.text}</span></li>)}
            </ul>
          </section>
        )}

        {goodToKnow && (
          <section id="good-to-know" class="block">
            <h2>{goodToKnow.title_he}</h2>
            {goodToKnow.lead_he && <p class="block__lede">{goodToKnow.lead_he}</p>}
            <ul class="gtk">
              {goodToKnow.items.map(it => (
                <li>
                  <h3>{it.title_he}</h3>
                  <p>{it.summary_he}</p>
                  {it.tips_url && <a href={localUrl(it.tips_url)}>להרחבה ←</a>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {g.phrasebook && (
          <section id="phrasebook" class="block">
            <h2>{g.phrasebook.title}</h2>
            <div class="phrases">
              {g.phrasebook.groups.map((grp, i) => (
                <details open={i === 0}>
                  <summary>{grp.name} <span>({grp.phrases.length})</span></summary>
                  <dl>
                    {grp.phrases.map(p => (
                      <div><dt>{p.he}</dt><dd><span class="say">{p.say}</span><span class="local" lang="und">{p.local}</span></dd></div>
                    ))}
                  </dl>
                </details>
              ))}
            </div>
          </section>
        )}

        {g.faq.length > 0 && (
          <section id="faq" class="block">
            <h2>שאלות נפוצות</h2>
            {g.faq.map(f => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}
      </div>

      <aside class="side" aria-label="תקציר הטיול">
        <div class="facts">
          <h2>הטיול בקצרה</h2>
          <dl>
            <div><dt>משך</dt><dd>{g.trip.days} ימים</dd></div>
            {g.trip.base && <div><dt>בסיס</dt><dd>{g.trip.base}</dd></div>}
            {g.trip.flight && <div><dt>טיסה</dt><dd>{g.trip.flight}</dd></div>}
          </dl>
          {g.bestMonths.length > 0 && (
            <>
              <h3>מתי הכי כדאי</h3>
              <ol class="months" aria-label={`חודשים מומלצים: ${g.bestMonths.map(m => MONTHS[m - 1]).join(", ")}`}>
                {MONTHS.map((m, i) => <li class={g.bestMonths.includes(i + 1) ? "on" : undefined} aria-hidden="true">{m}</li>)}
              </ol>
            </>
          )}
          {g.highlights.length > 0 && (
            <>
              <h3>לא לפספס</h3>
              <ul class="chips">{g.highlights.map(h => <li>{h}</li>)}</ul>
            </>
          )}
          <a class="btn btn--wa" href={whatsappLink(`היי, קראתי את ${g.title} ויש לי שאלה`)}>שאלה על היעד? וואטסאפ</a>
        </div>
      </aside>
    </div>

    <section class="cta">
      <div class="container cta__inner">
        <h2>הטיול הבא שלכם מתחיל כאן</h2>
        <p>רוצים מסלול כזה, מותאם לגילאים ולקצב של המשפחה שלכם? נשמח לתכנן איתכם.</p>
        <div class="cta__actions">
          <a class="btn btn--amber" href="/packages.html">לחבילות התכנון</a>
          <a class="btn btn--light" href="/destinations.html">לכל היעדים</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  h1, h2, h3 { font-family: var(--font-heading); font-weight: 400; color: var(--charcoal); line-height: 1.2; text-wrap: balance; }
  .guide { --c: var(--teal); }

  .hero { position: relative; min-height: clamp(300px, 46vw, 460px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--teal-dark); }
  .hero :global(.hero__img), .hero :global(picture) { position: absolute; inset: 0; }
  .hero :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.1) 20%, rgba(0,0,0,.72)); }
  .hero__inner { position: relative; padding-block: 28px 30px; display: grid; gap: 10px; width: 100%; }
  .hero h1 { color: #fff; font-size: clamp(2.1rem, 5.5vw, 3.4rem); text-shadow: 0 2px 18px rgba(0,0,0,.35); }
  .crumbs { display: flex; gap: 8px; font-size: 14px; opacity: .92; }
  .crumbs a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .hero__facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .hero__facts li { background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.35); backdrop-filter: blur(6px); border-radius: 999px; padding: 4px 12px; font-size: 14px; }

  .toc { position: sticky; top: var(--nav-height); z-index: 50; background: rgba(253,248,242,.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--sand-dark); }
  .toc__inner { display: flex; gap: 6px; overflow-x: auto; padding-block: 10px; scrollbar-width: none; }
  .toc a { flex: none; font-size: 14px; font-weight: 600; color: var(--teal-dark); padding: 6px 14px; border-radius: 999px; border: 1.5px solid var(--sand-dark); background: #fff; }
  .toc a:hover, .toc a:focus-visible { border-color: var(--c); color: var(--c); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 36px; padding-block: 36px 56px; align-items: start; }
  .main { display: grid; gap: 44px; min-width: 0; }
  .block { display: grid; gap: 14px; scroll-margin-top: calc(var(--nav-height) + 64px); }
  .block h2 { font-size: clamp(1.5rem, 3vw, 1.95rem); color: var(--teal-dark); }
  .block__lede { color: #5a5a5a; }
  .prose { display: grid; gap: 14px; font-size: 1.06rem; line-height: 1.8; color: #3a3a3a; max-width: 68ch; }

  /* Day-by-day: a spine on the right with one node per day */
  .days { list-style: none; display: grid; gap: 14px; position: relative; padding-right: 50px; }
  .days::before { content: ""; position: absolute; top: 18px; bottom: 18px; right: 19px; width: 2px; background: repeating-linear-gradient(180deg, var(--c) 0 8px, transparent 8px 14px); opacity: .45; }
  .day { position: relative; }
  .day__node { position: absolute; right: -50px; top: 10px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: #fff; border: 2px solid var(--c); font-size: 18px; box-shadow: var(--shadow-sm); }
  .day__card { background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden; }
  .day__card[open] { box-shadow: var(--shadow-md); }
  .day__card summary { list-style: none; cursor: pointer; padding: 14px 18px; display: grid; gap: 3px; position: relative; padding-left: 44px; }
  .day__card summary::-webkit-details-marker { display: none; }
  .day__card summary::after { content: "▾"; position: absolute; left: 18px; top: 16px; color: var(--c); transition: transform .2s; }
  .day__card[open] summary::after { transform: rotate(180deg); }
  .day__num { font-size: 13px; font-weight: 700; color: var(--c); }
  .day__date { font-weight: 500; color: #777; }
  .day__title { font-family: var(--font-heading); font-size: 1.3rem; color: var(--charcoal); }
  .day__where { font-size: 14px; color: #666; }
  .day__badge { justify-self: start; margin-top: 4px; font-size: 12.5px; font-weight: 600; color: var(--c); background: color-mix(in srgb, var(--c) 10%, #fff); border-radius: 999px; padding: 2px 10px; }
  .day__body { padding: 4px 18px 18px; display: grid; gap: 10px; border-top: 1px dashed var(--sand-dark); }
  .stops { list-style: none; display: grid; }
  .stop { display: grid; grid-template-columns: 74px 1fr; gap: 12px; padding-block: 10px; border-bottom: 1px solid #f1ebe0; }
  .stop:last-child { border-bottom: 0; }
  .stop__time { font-size: 13px; font-weight: 700; color: var(--teal); font-variant-numeric: tabular-nums; padding-top: 2px; }
  .stop p { font-size: 15px; color: #555; line-height: 1.6; margin-top: 2px; }
  .note { font-size: 14.5px; background: var(--cream); border-radius: var(--radius-sm); padding: 8px 12px; color: #444; }
  .note--tip { background: color-mix(in srgb, var(--amber) 14%, #fff); }
  .day__maplink { justify-self: start; font-size: 14px; font-weight: 600; color: var(--teal); }

  .cards { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .card { background: #fff; border: 1.5px solid var(--sand-dark); border-radius: var(--radius-md); padding: 14px 16px; display: grid; gap: 6px; justify-items: start; }
  .card__name { font-size: 1.05rem; }
  .card__text { font-size: 14px; color: #666; }
  .stays-map { border: 0; border-radius: var(--radius-lg); background: var(--sand); }

  .grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .tile { background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--radius-lg); padding: 16px; display: grid; gap: 6px; align-content: start; }
  .tile__icon { font-size: 26px; }
  .tile h3 { font-size: 1.12rem; }
  .tile p { font-size: 15px; color: #555; line-height: 1.6; }

  .tips { list-style: none; display: grid; gap: 8px; }
  .tips li { display: grid; grid-template-columns: 28px 1fr; gap: 8px; background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--radius-md); padding: 10px 14px; line-height: 1.6; }

  .gtk { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .gtk li { background: var(--sand); border-radius: var(--radius-md); padding: 14px; display: grid; gap: 6px; align-content: start; }
  .gtk h3 { font-size: 1.05rem; color: var(--teal-dark); }
  .gtk p { font-size: 14.5px; color: #4a4a4a; line-height: 1.6; }
  .gtk a { font-size: 14px; font-weight: 700; color: var(--teal); }

  .phrases { display: grid; gap: 8px; }
  .phrases details { background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--radius-md); }
  .phrases summary { cursor: pointer; padding: 10px 14px; font-weight: 700; color: var(--teal-dark); }
  .phrases summary span { font-weight: 400; color: #888; }
  .phrases dl { display: grid; padding: 0 14px 10px; }
  .phrases dl div { display: grid; grid-template-columns: minmax(90px, 1fr) 2fr; gap: 10px; padding-block: 8px; border-top: 1px solid #f1ebe0; }
  .phrases dt { font-weight: 600; }
  .phrases dd { display: grid; gap: 2px; }
  .phrases .say { color: var(--teal-dark); }
  .phrases .local { font-size: 13.5px; color: #777; direction: ltr; text-align: right; }

  .faq { background: #fff; border: 1px solid var(--sand-dark); border-radius: var(--radius-md); padding: 10px 14px; }
  .faq summary { cursor: pointer; font-weight: 700; }
  .faq p { margin-top: 8px; color: #555; line-height: 1.7; }

  .side { position: sticky; top: calc(var(--nav-height) + 70px); }
  .facts { background: #fff; border: 1px solid var(--sand-dark); border-top: 4px solid var(--c); border-radius: var(--radius-lg); padding: 18px; display: grid; gap: 12px; box-shadow: var(--shadow-sm); }
  .facts h2 { font-size: 1.3rem; color: var(--teal-dark); }
  .facts h3 { font-size: 1rem; color: var(--teal-dark); margin-top: 4px; }
  .facts dl { display: grid; gap: 6px; }
  .facts dl div { display: flex; justify-content: space-between; gap: 10px; font-size: 14.5px; border-bottom: 1px dashed var(--sand-dark); padding-bottom: 6px; }
  .facts dt { color: #777; }
  .facts dd { font-weight: 600; text-align: left; }
  .months { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
  .months li { font-size: 11.5px; text-align: center; padding: 5px 0; border-radius: 6px; background: var(--cream); color: #999; }
  .months li.on { background: var(--c); color: #fff; font-weight: 600; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { font-size: 13px; border: 1px solid color-mix(in srgb, var(--c) 30%, #fff); background: color-mix(in srgb, var(--c) 8%, #fff); border-radius: 999px; padding: 2px 10px; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-radius: 999px; padding: 9px 18px; font-size: 15px; font-weight: 600; min-height: 44px; transition: background .2s, transform .15s; }
  .btn:active { transform: scale(.97); }
  .btn--primary { background: var(--teal); color: #fff; min-height: 38px; padding: 7px 14px; font-size: 14px; }
  .btn--primary:hover { background: var(--teal-dark); }
  .btn--wa { background: var(--whatsapp); color: #fff; }
  .btn--amber { background: var(--amber); color: #2b1d07; }
  .btn--light { background: rgba(255,255,255,.14); color: #fff; border: 1.5px solid rgba(255,255,255,.45); }

  .cta { background: linear-gradient(135deg, var(--teal-dark), var(--teal)); color: #fff; padding-block: clamp(40px, 6vw, 64px); }
  .cta__inner { display: grid; gap: 12px; justify-items: start; }
  .cta h2 { color: #fff; font-size: clamp(1.6rem, 3.4vw, 2.2rem); }
  .cta p { opacity: .9; }
  .cta__actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; order: -1; }
  }
  @media (max-width: 520px) {
    .days { padding-right: 0; }
    .days::before, .day__node { display: none; }
    .stop { grid-template-columns: 1fr; gap: 2px; }
    .phrases dl div { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .day__card summary::after { transition: none; } }
</style>
