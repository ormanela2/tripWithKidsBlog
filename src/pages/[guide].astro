---
/**
 * Every destination guide, at /<slug>.html.
 * - Structured guides (src/content/guides): built from data by StructuredGuide.
 * - Carried-over guides (src/content/html-guides): the live page as it is, by HtmlGuide.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import StructuredGuide from "../components/guide/StructuredGuide.astro";
import HtmlGuide from "../components/guide/HtmlGuide.astro";

export async function getStaticPaths() {
  const structured = await getCollection("guides", g => !g.data.draft);
  const carried = await getCollection("htmlGuides", g => !g.data.draft);
  const ids = new Set(structured.map(g => g.id));
  const clash = carried.find(g => ids.has(g.id));
  if (clash) throw new Error(`Guide "${clash.id}" exists both as a structured and a carried-over guide. Keep one.`);
  return [
    ...structured.map(g => ({ params: { guide: g.id }, props: { kind: "structured" as const, entry: g } })),
    ...carried.map(g => ({ params: { guide: g.id }, props: { kind: "html" as const, entry: g } })),
  ];
}

type Props =
  | { kind: "structured"; entry: CollectionEntry<"guides"> }
  | { kind: "html"; entry: CollectionEntry<"htmlGuides"> };
const props = Astro.props;
---
{props.kind === "structured" ? <StructuredGuide entry={props.entry} /> : <HtmlGuide entry={props.entry} />}
